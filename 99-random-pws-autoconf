# Validate discovered radios before changing configuration.
radio_2g=
radio_5g=
index=0
while uci -q get "wireless.@wifi-device[$index]" >/dev/null; do
    radio="@wifi-device[$index]"
    band=$(uci -q get "wireless.$radio.band") || exit 1
    case "$band" in
        2g)
            [ -z "$radio_2g" ] || exit 1
            radio_2g=$radio
            ;;
        5g)
            [ -z "$radio_5g" ] || exit 1
            radio_5g=$radio
            ;;
        *)
            echo "Unexpected wireless band: $band" >&2
            exit 1
            ;;
    esac
    index=$((index + 1))
done
if [ -z "$radio_2g" ] || [ -z "$radio_5g" ]; then
    echo "Expected one 2.4 GHz radio and one 5 GHz radio" >&2
    exit 1
fi

ifaces_2g=
ifaces_5g=
index=0
while uci -q get "wireless.@wifi-iface[$index]" >/dev/null; do
    iface="@wifi-iface[$index]"
    mode=$(uci -q get "wireless.$iface.mode") || exit 1
    if [ "$mode" = "ap" ]; then
        device=$(uci -q get "wireless.$iface.device") || exit 1
        band=$(uci -q get "wireless.$device.band") || exit 1
        case "$band" in
            2g) ifaces_2g="$ifaces_2g $iface" ;;
            5g) ifaces_5g="$ifaces_5g $iface" ;;
            *) exit 1 ;;
        esac
    fi
    index=$((index + 1))
done
if [ -z "$ifaces_2g" ] || [ -z "$ifaces_5g" ]; then
    echo "Expected an AP interface on each band" >&2
    exit 1
fi

# Configure network interfaces
uci set dhcp.lan.ignore="1"
uci set dhcp.lan.dhcpv4="disabled"
uci set dhcp.lan.dhcpv6="disabled"
uci set dhcp.lan.ra="disabled"
uci set dhcp.lan.ndp="disabled"

uci -q delete network.lan.ipaddr
uci add_list network.lan.ipaddr="192.168.1.1/24"

# DHCP management on the same bridge as the static debugging address
uci set network.lan_dhcp="interface"
uci set network.lan_dhcp.device="@lan"
uci set network.lan_dhcp.proto="dhcp"
uci set network.lan_dhcp.defaultroute="1"
uci set network.lan_dhcp.peerdns="1"

zone=0
while name=$(uci -q get "firewall.@zone[$zone].name"); do
    if [ "$name" = "lan" ]; then
        uci -q del_list "firewall.@zone[$zone].network=lan_dhcp"
        uci add_list "firewall.@zone[$zone].network=lan_dhcp"
        break
    fi
    zone=$((zone + 1))
done

uci commit dhcp
uci commit network
uci commit firewall

for radio in "$radio_2g" "$radio_5g"; do
    uci set "wireless.$radio.country=DE" || exit 1
    uci set "wireless.$radio.channel=auto" || exit 1
    uci set "wireless.$radio.disabled=0" || exit 1
done

# Room-scale 2.4 GHz baseline; retain DFS-capable ACS on 5 GHz.
uci set "wireless.$radio_2g.htmode=HT20" || exit 1
uci set "wireless.$radio_2g.txpower=9" || exit 1
if uci -q get "wireless.$radio_2g.chanlist" >/dev/null; then
    uci delete "wireless.$radio_2g.chanlist" || exit 1
fi
for channel in 1 6 11; do
    uci add_list "wireless.$radio_2g.chanlist=$channel" || exit 1
done

for iface in $ifaces_2g $ifaces_5g; do
    uci set "wireless.$iface.ssid={ssid}" || exit 1
    uci set "wireless.$iface.encryption=psk2" || exit 1
    uci set "wireless.$iface.key={wifi_password}" || exit 1
    uci set "wireless.$iface.disabled=0" || exit 1
done

uci commit wireless || exit 1

# Set root password
(
    echo "{root_password}"
    sleep 1
    echo "{root_password}"
) | passwd
