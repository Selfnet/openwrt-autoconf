# Configure network interfaces
uci set dhcp.lan.ignore="1"
uci set dhcp.lan.dhcpv4="disabled"
uci set dhcp.lan.dhcpv6="disabled"
uci set dhcp.lan.ra="disabled"
uci set dhcp.lan.ndp="disabled"

uci -q delete network.lan.ipaddr
uci add_list network.lan.ipaddr="192.168.1.1/24"

# DHCP management on the same bridge as the static debugging address
uci set network.lan_dhcp="interface"
uci set network.lan_dhcp.device="@lan"
uci set network.lan_dhcp.proto="dhcp"
uci set network.lan_dhcp.defaultroute="1"
uci set network.lan_dhcp.peerdns="1"

zone=0
while name=$(uci -q get "firewall.@zone[$zone].name"); do
    if [ "$name" = "lan" ]; then
        uci -q del_list "firewall.@zone[$zone].network=lan_dhcp"
        uci add_list "firewall.@zone[$zone].network=lan_dhcp"
        break
    fi
    zone=$((zone + 1))
done

uci commit dhcp
uci commit network
uci commit firewall

# 5 GHz
uci set wireless.radio0.country="DE"
uci set wireless.radio0.channel="auto"
uci set wireless.radio0.disabled="0"
uci set wireless.default_radio0.ssid="{ssid}"
uci set wireless.default_radio0.encryption="psk2"
uci set wireless.default_radio0.key="{wifi_password}"
uci set wireless.default_radio0.disabled="0"

# 2.5 GHz (limit TX power to reduce interference)
uci set wireless.radio1.country="DE"
uci set wireless.radio1.channel="auto"
uci set wireless.radio1.disabled="0"
uci set wireless.radio1.txpower="9"
uci set wireless.default_radio1.ssid="{ssid}"
uci set wireless.default_radio1.encryption="psk2"
uci set wireless.default_radio1.key="{wifi_password}"
uci set wireless.default_radio1.disabled="0"

uci commit wireless

# Set root password
(
    echo "{root_password}"
    sleep 1
    echo "{root_password}"
) | passwd
